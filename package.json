{
    "name": "httpkeeper",
    "displayName": "HttpKeeper",
    "description": "Send HTTP requests from a .http file and read the response in the editor. No account, no cloud, no paywall. A maintained fork of REST Client.",
    "version": "1.0.0",
    "publisher": "argalla",
    "author": {
        "name": "Huachao Mao",
        "email": "huachaomao@gmail.com"
    },
    "icon": "images/icon.png",
    "galleryBanner": {
        "color": "#0F1A24",
        "theme": "dark"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/TecniartGalicia/httpkeeper/issues"
    },
    "homepage": "https://github.com/TecniartGalicia/httpkeeper#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/TecniartGalicia/httpkeeper.git"
    },
    "engines": {
        "vscode": "^1.81.0"
    },
    "categories": [
        "Other",
        "Snippets",
        "Linters",
        "Programming Languages"
    ],
    "keywords": [
        "http",
        "rest",
        "api",
        "http client",
        "rest client",
        "request",
        "curl",
        "graphql",
        "testing",
        "postman alternative"
    ],
    "activationEvents": [
        "onLanguage:markdown"
    ],
    "main": "./dist/extension",
    "contributes": {
        "languages": [
            {
                "id": "http",
                "aliases": [
                    "HTTP",
                    "Http",
                    "http"
                ],
                "extensions": [
                    ".http",
                    ".rest"
                ],
                "firstLine": "^(GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS|CONNECT|TRACE|LOCK|UNLOCK|PROPFIND|PROPPATCH|COPY|MOVE|MKCOL|MKCALENDAR|ACL|SEARCH)\\s+(.*?)HTTP/[0-9\\.]+$",
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "http",
                "scopeName": "source.http",
                "path": "./syntaxes/http.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "http",
                "path": "./snippets/http.json"
            }
        ],
        "commands": [
            {
                "command": "httpkeeper.request",
                "title": "Send Request",
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.rerun-last-request",
                "title": "Rerun Last Request",
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.cancel-request",
                "title": "Cancel Request",
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.switch-environment",
                "title": "Switch Environment",
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.history",
                "title": "View Request History",
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.clear-history",
                "title": "Clear Request History",
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.save-response",
                "title": "Save Full Response",
                "icon": {
                    "light": "./images/save.svg",
                    "dark": "./images/save-inverse.svg"
                },
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.save-response-body",
                "title": "Save Response Body",
                "icon": {
                    "light": "./images/save-body.svg",
                    "dark": "./images/save-body-inverse.svg"
                },
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.copy-response-body",
                "title": "Copy Response Body",
                "icon": {
                    "light": "./images/copy.svg",
                    "dark": "./images/copy-inverse.svg"
                },
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.generate-codesnippet",
                "title": "Generate Code Snippet",
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.copy-codesnippet",
                "title": "Copy Code Snippet",
                "icon": {
                    "light": "./images/copy.svg",
                    "dark": "./images/copy-inverse.svg"
                },
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.copy-request-as-curl",
                "title": "Copy Request As cURL",
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.clear-aad-token-cache",
                "title": "Clear Azure AD Token Cache",
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.clear-cookies",
                "title": "Clear cookies",
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.fold-response",
                "title": "Fold Response",
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.unfold-response",
                "title": "Unfold Response",
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.preview-html-response-body",
                "title": "HTML Preview",
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.show-raw-response",
                "title": "Raw",
                "category": "Rest Client"
            },
            {
                "command": "httpkeeper.import-swagger",
                "title": "Import from file",
                "category": "Rest Client"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "httpkeeper.fold-response",
                    "when": "httpResponsePreviewFocus"
                },
                {
                    "command": "httpkeeper.unfold-response",
                    "when": "httpResponsePreviewFocus"
                },
                {
                    "command": "httpkeeper.preview-html-response-body",
                    "when": "isHTMLResponse"
                },
                {
                    "command": "httpkeeper.show-raw-response",
                    "when": "isHTMLResponse"
                },
                {
                    "command": "httpkeeper.save-response",
                    "when": "httpResponsePreviewFocus"
                },
                {
                    "command": "httpkeeper.save-response-body",
                    "when": "httpResponsePreviewFocus"
                },
                {
                    "command": "httpkeeper.copy-response-body",
                    "when": "httpResponsePreviewFocus"
                },
                {
                    "command": "httpkeeper.copy-codesnippet",
                    "when": "codeSnippetPreviewFocus"
                }
            ],
            "editor/title": [
                {
                    "when": "httpResponsePreviewFocus",
                    "command": "httpkeeper.save-response",
                    "group": "navigation@1"
                },
                {
                    "when": "httpResponsePreviewFocus",
                    "command": "httpkeeper.save-response-body",
                    "group": "navigation@2"
                },
                {
                    "when": "httpResponsePreviewFocus",
                    "command": "httpkeeper.copy-response-body",
                    "group": "navigation@3"
                },
                {
                    "when": "httpResponsePreviewFocus",
                    "command": "httpkeeper.fold-response",
                    "group": "1_rest-client@1"
                },
                {
                    "when": "httpResponsePreviewFocus",
                    "command": "httpkeeper.unfold-response",
                    "group": "1_rest-client@2"
                },
                {
                    "when": "isHTMLResponse",
                    "command": "httpkeeper.preview-html-response-body",
                    "group": "1_rest-client@3"
                },
                {
                    "when": "isHTMLResponse",
                    "command": "httpkeeper.show-raw-response",
                    "group": "1_rest-client@4"
                },
                {
                    "when": "codeSnippetPreviewFocus",
                    "command": "httpkeeper.copy-codesnippet",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "command": "httpkeeper.request",
                    "when": "editorTextFocus && editorLangId == http",
                    "group": "rest-client@1"
                },
                {
                    "command": "httpkeeper.generate-codesnippet",
                    "when": "editorTextFocus && editorLangId == http",
                    "group": "rest-client@2"
                },
                {
                    "command": "httpkeeper.copy-request-as-curl",
                    "when": "editorTextFocus && editorLangId == http",
                    "group": "rest-client@3"
                }
            ]
        },
        "keybindings": [
            {
                "command": "httpkeeper.request",
                "key": "ctrl+alt+r",
                "mac": "cmd+alt+r",
                "when": "editorTextFocus && editorLangId == 'http'"
            },
            {
                "command": "httpkeeper.request",
                "key": "ctrl+alt+r",
                "mac": "cmd+alt+r",
                "when": "editorTextFocus && editorLangId == 'plaintext'"
            },
            {
                "command": "httpkeeper.rerun-last-request",
                "key": "ctrl+alt+l",
                "mac": "cmd+alt+l",
                "when": "editorTextFocus && editorLangId == 'http'"
            },
            {
                "command": "httpkeeper.rerun-last-request",
                "key": "ctrl+alt+l",
                "mac": "cmd+alt+l",
                "when": "editorTextFocus && editorLangId == 'plaintext'"
            },
            {
                "command": "httpkeeper.rerun-last-request",
                "key": "ctrl+alt+l",
                "mac": "cmd+alt+l",
                "when": "httpResponsePreviewFocus"
            },
            {
                "command": "httpkeeper.cancel-request",
                "key": "ctrl+alt+k",
                "mac": "cmd+alt+k",
                "when": "editorTextFocus && editorLangId == 'http'"
            },
            {
                "command": "httpkeeper.cancel-request",
                "key": "ctrl+alt+k",
                "mac": "cmd+alt+k",
                "when": "editorTextFocus && editorLangId == 'plaintext'"
            },
            {
                "command": "httpkeeper.history",
                "key": "ctrl+alt+h",
                "mac": "cmd+alt+h"
            },
            {
                "command": "httpkeeper.switch-environment",
                "key": "ctrl+alt+e",
                "mac": "cmd+alt+e"
            },
            {
                "command": "httpkeeper.generate-codesnippet",
                "key": "ctrl+alt+c",
                "mac": "cmd+alt+c",
                "when": "editorTextFocus && editorLangId == 'http'"
            },
            {
                "command": "httpkeeper.generate-codesnippet",
                "key": "ctrl+alt+c",
                "mac": "cmd+alt+c",
                "when": "editorTextFocus && editorLangId == 'plaintext'"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "REST Client",
            "properties": {
                "httpkeeper.followredirect": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Follow HTTP 3xx responses as redirects."
                },
                "httpkeeper.defaultHeaders": {
                    "type": "object",
                    "default": {
                        "User-Agent": "vscode-restclient"
                    },
                    "scope": "resource",
                    "description": "If particular headers are omitted in request headers, these will be added as headers for each request."
                },
                "httpkeeper.timeoutinmilliseconds": {
                    "type": "integer",
                    "default": 0,
                    "scope": "resource",
                    "description": "Timeout in milliseconds. 0 for infinity"
                },
                "httpkeeper.showResponseInDifferentTab": {
                    "type": "boolean",
                    "default": false,
                    "scope": "resource",
                    "description": "Show response in different tab"
                },
                "httpkeeper.requestNameAsResponseTabTitle": {
                    "type": "boolean",
                    "default": false,
                    "scope": "resource",
                    "description": "Show request name as the response tab title"
                },
                "httpkeeper.rememberCookiesForSubsequentRequests": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Remember cookies for subsequent requests"
                },
                "httpkeeper.excludeHostsForProxy": {
                    "type": "array",
                    "default": [],
                    "scope": "resource",
                    "description": "Excluded hosts when using using proxy settings"
                },
                "httpkeeper.fontSize": {
                    "type": "number",
                    "scope": "resource",
                    "markdownDescription": "Controls the font size in pixels used in the response preview. When set to `0`, the value of `#editor.fontSize#` is used."
                },
                "httpkeeper.fontFamily": {
                    "type": "string",
                    "default": null,
                    "scope": "resource",
                    "description": "Controls the font family used in the response preview"
                },
                "httpkeeper.fontWeight": {
                    "type": "string",
                    "enum": [
                        "normal",
                        "bold",
                        "bolder",
                        "lighter",
                        "100",
                        "200",
                        "300",
                        "400",
                        "500",
                        "600",
                        "700",
                        "800",
                        "900"
                    ],
                    "scope": "resource",
                    "description": "Controls the font weight used in the response preview"
                },
                "httpkeeper.environmentVariables": {
                    "type": "object",
                    "default": {
                        "$shared": {}
                    },
                    "scope": "resource",
                    "markdownDescription": "Sets the environments and custom variables belongs to it, especially the special environment name '$shared' is used to create variables shared across all the individual environments (e.g., `{\"$shared\": {\"version\": \"v1\"}, \"production\": {\"host\": \"api.example.com\"}, \"sandbox\":{\"host\":\"sandbox.api.example.com\"}}`)",
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "type": "object",
                                "default": {},
                                "description": "Sets the custom variables belong to this environment",
                                "additionalProperties": {
                                    "anyOf": [
                                        {
                                            "type": "string",
                                            "description": "Value of the custom variable"
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                },
                "httpkeeper.mimeAndFileExtensionMapping": {
                    "type": "object",
                    "default": {},
                    "scope": "resource",
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "type": "string"
                            }
                        ]
                    },
                    "markdownDescription": "Sets the custom mapping of mime type and file extension of saved response body (e.g., `{\"application/atom+xml\": \"xml\"}`)"
                },
                "httpkeeper.previewResponseInUntitledDocument": {
                    "type": "boolean",
                    "default": false,
                    "scope": "resource",
                    "description": "Preview response in untitled document if set to true, otherwise displayed in html view"
                },
                "httpkeeper.oidcScopes": {
                    "type": "array",
                    "default": [],
                    "scope": "resource",
                    "description": "Scopes to be used by the OIDC client, default: [openid profile email]"
                },
                "httpkeeper.oidcCertificates": {
                    "type": "object",
                    "default": {},
                    "scope": "resource",
                    "description": "Certificate paths for Oidc callback server",
                    "pattern": "^(?!http(s?)://)",
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "type": "object",
                                "default": {},
                                "description": "Certifcate paths for Oidc callback server",
                                "properties": {
                                    "cert": {
                                        "type": "string",
                                        "description": "Absolute or relative path of Public x509 certificate"
                                    },
                                    "key": {
                                        "type": "string",
                                        "description": "Absolute or relative path of Private key"
                                    },
                                    "pfx": {
                                        "type": "string",
                                        "description": "Absolute or relative path of PKCS #12 certificate"
                                    },
                                    "passphrase": {
                                        "type": "string",
                                        "description": "[Optional] A string of passphrase for the private key or pfx"
                                    }
                                },
                                "dependencies": {
                                    "cert": [
                                        "key"
                                    ],
                                    "key": [
                                        "cert"
                                    ]
                                }
                            }
                        ]
                    }
                },
                "httpkeeper.certificates": {
                    "type": "object",
                    "default": {},
                    "scope": "resource",
                    "description": "Certificate paths for different hosts. The path can be absolute path or relative path(relative to workspace or current http file)",
                    "pattern": "^(?!http(s?)://)",
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "type": "object",
                                "default": {},
                                "description": "Certifcate paths for specific host(e.g., foo.com, bar.org:8081), port is optional",
                                "properties": {
                                    "cert": {
                                        "type": "string",
                                        "description": "Absolute or relative path of Public x509 certificate"
                                    },
                                    "key": {
                                        "type": "string",
                                        "description": "Absolute or relative path of Private key"
                                    },
                                    "pfx": {
                                        "type": "string",
                                        "description": "Absolute or relative path of PKCS #12 certificate"
                                    },
                                    "passphrase": {
                                        "type": "string",
                                        "description": "[Optional] A string of passphrase for the private key or pfx"
                                    }
                                },
                                "dependencies": {
                                    "cert": [
                                        "key"
                                    ],
                                    "key": [
                                        "cert"
                                    ]
                                }
                            }
                        ]
                    }
                },
                "httpkeeper.suppressResponseBodyContentTypeValidationWarning": {
                    "type": "boolean",
                    "default": false,
                    "scope": "resource",
                    "description": "Suppress response body content type validation"
                },
                "httpkeeper.previewOption": {
                    "type": "string",
                    "enum": [
                        "full",
                        "headers",
                        "body",
                        "exchange"
                    ],
                    "enumDescriptions": [
                        "Response headers, body and status line",
                        "Response headers and status line",
                        "Response body only",
                        "Whole HTTP exchange including both request and response"
                    ],
                    "default": "full",
                    "scope": "resource",
                    "description": "Response preview output option"
                },
                "httpkeeper.disableHighlightResponseBodyForLargeResponse": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "markdownDescription": "Controls whether to highlight response body for response whose size is larger than limit specified by `rest-client.largeResponseSizeLimitInMB`"
                },
                "httpkeeper.disableAddingHrefLinkForLargeResponse": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "markdownDescription": "Controls whether to add href link in previewed response for response whose size is larger than limit specified by `rest-client.largeResponseSizeLimitInMB`"
                },
                "httpkeeper.largeResponseBodySizeLimitInMB": {
                    "type": "number",
                    "default": 5,
                    "minimum": 0,
                    "exclusiveMinimum": true,
                    "scope": "resource",
                    "markdownDescription": "Set the response body size threshold of MB to identify whether a response is a so-called 'large response', only used when `rest-client.disableHighlightResponseBodyForLargeResponse` and/or `rest-client.disableAddingHrefLinkForLargeResponse` is set to true"
                },
                "httpkeeper.previewColumn": {
                    "type": "string",
                    "enum": [
                        "current",
                        "beside"
                    ],
                    "markdownEnumDescriptions": [
                        "Preview in the column of current request file",
                        "previewing at the side of the current active column and the side direction depends on `workbench.editor.openSideBySideDirection` setting, either right or below the current editor column"
                    ],
                    "default": "beside",
                    "scope": "resource",
                    "description": "Response preview column option"
                },
                "httpkeeper.previewResponsePanelTakeFocus": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Preview response panel will take focus after receiving response."
                },
                "httpkeeper.formParamEncodingStrategy": {
                    "type": "string",
                    "enum": [
                        "automatic",
                        "never",
                        "always"
                    ],
                    "markdownEnumDescriptions": [
                        "Detecting encoding or not automatically and do the encoding job if necessary",
                        "Treat provided request body as is, no encoding job will be applied",
                        "Use for the scenario that `automatic` option not working properly, e.g., some special characters(`+`) are not encoded correctly"
                    ],
                    "default": "automatic",
                    "scope": "resource",
                    "markdownDescription": "Form param encoding strategy for request body of `x-www-form-urlencoded`."
                },
                "httpkeeper.addRequestBodyLineIndentationAroundBrackets": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "markdownDescription": "Add line indentation around brackets(`{}`, `<>`, `[]`) in request body when pressing enter."
                },
                "httpkeeper.decodeEscapedUnicodeCharacters": {
                    "type": "boolean",
                    "default": false,
                    "scope": "resource",
                    "description": "Decode escaped unicode characters in response body."
                },
                "httpkeeper.logLevel": {
                    "type": "string",
                    "enum": [
                        "error",
                        "warn",
                        "info",
                        "verbose"
                    ],
                    "default": "error",
                    "scope": "resource",
                    "description": "The verbosity of logging in the REST output panel"
                },
                "httpkeeper.enableSendRequestCodeLens": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Enable/disable sending request CodeLens in request file"
                },
                "httpkeeper.enableCustomVariableReferencesCodeLens": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Enable/disable custom variable references CodeLens in request file"
                },
                "httpkeeper.useContentDispositionFilename": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Enable/disable using filename from 'content-disposition' header, when saving response body"
                }
            }
        },
        "configurationDefaults": {
            "[http]": {
                "editor.quickSuggestions": {
                    "other": true,
                    "comments": false,
                    "strings": true
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "webpack --mode production",
        "webpack": "webpack --mode development",
        "watch": "webpack --mode development --watch",
        "tslint": "tslint --project tsconfig.json",
        "compile-tests": "tsc -p tsconfig.test.json",
        "test:unit": "npm run compile-tests && mocha \"out-test/test/unit/**/*.test.js\"",
        "test:integration": "npm run compile-tests && node ./out-test/test/integration/runTest.js",
        "test": "npm run test:unit && npm run test:integration",
        "build:cli": "tsc -p tsconfig.cli.json",
        "test:cli": "npm run build:cli && node scripts/probar-cli.mjs",
        "audit": "node scripts/auditoria.mjs",
        "check": "npx tsc -p ./ --noEmit --skipLibCheck && npm run test:unit && npm run build:cli && npm run test:cli && npm run audit"
    },
    "devDependencies": {
        "@types/aws4": "^1.5.1",
        "@types/fs-extra": "^5.0.4",
        "@types/jws": "^3.2.10",
        "@types/mocha": "^5.2.7",
        "@types/node": "^20.19.43",
        "@types/node-fetch": "^2.6.11",
        "@types/vscode": "^1.81.0",
        "@vscode/test-electron": "^3.1.0",
        "glob": "^13.0.6",
        "mocha": "^10.8.2",
        "ts-loader": "^7.0.5",
        "tslint": "^6.1.2",
        "typescript": "^5.9.3",
        "webpack": "^5.75.0",
        "webpack-cli": "^5.0.1"
    },
    "dependencies": {
        "@xmldom/xmldom": "^0.9.12",
        "adal-node": "^0.2.4",
        "aws4": "^1.9.1",
        "code-highlight-linenums": "^0.2.1",
        "combined-stream": "^1.0.5",
        "content-disposition": "^0.5.3",
        "dayjs": "^1.8.20",
        "dotenv": "^8.2.0",
        "encodeurl": "^1.0.1",
        "filesize": "^3.3.0",
        "fs-extra": "^5.0.0",
        "got": "^11.8.6",
        "highlight.js": "^10.4.1",
        "http-proxy-agent": "^2.1.0",
        "https-proxy-agent": "^2.2.3",
        "httpsnippet": "^3.0.10",
        "iconv-lite": "^0.4.15",
        "jsonc-parser": "^2.0.2",
        "jsonpath-plus": "^10.4.0",
        "mime-types": "^2.1.14",
        "node-fetch": "^2.6.7",
        "node-jws": "^0.1.4",
        "open": "^10.1.0",
        "pretty-data": "^0.40.0",
        "sanitize-html": "^2.13.0",
        "tough-cookie": "^4.1.3",
        "tough-cookie-file-store": "^2.0.3",
        "uuid": "^3.3.2",
        "xpath": "^0.0.27",
        "yargs-parser": "^21.1.1"
    },
    "pricing": "Free",
    "preview": true,
    "qna": "https://github.com/TecniartGalicia/httpkeeper/discussions",
    "l10n": "./l10n",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "A .http file can point anywhere; requests are only sent when you ask for them."
        }
    },
    "bin": {
        "httpkeeper": "./dist-cli/cli/index.js"
    }
}
