{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "outDir": "dist-cli",
    "rootDir": "src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "types": [
      "node"
    ],
    "experimentalDecorators": true
  },
  "include": [
    "src/cli/**/*.ts",
    "src/core/**/*.ts"
  ],
  "exclude": [
    "src/test/**/*"
  ]
}
